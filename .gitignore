# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude local and sensitive .tfvars files
*.secret.tfvars
*.local.tfvars
*.tfvars
*.tfvars.json

# Allow committed environment configurations (GitOps source of truth)
!terraform/environments/**/*.tfvars
!*.example
!*.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS and Editor files
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/

# dbt
dbt_olist/target/
dbt_olist/dbt_packages/
dbt_olist/logs/
