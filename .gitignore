# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Backend configuration files
backend.hcl
*.backend.hcl
*.tfbackend

# Include example configs
!*.example
!*.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS and Editor files
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
